# Anthropic API - https://console.anthropic.com/ (opsiyonel)
ANTHROPIC_API_KEY=buraya_anthropic_api_key_yaz

# Steam Web API Key - https://steamcommunity.com/dev/apikey adresinden ücretsiz al
STEAM_API_KEY=08D291AEE899F96FB0A32010A04B01A4

# Sitenin base URL'i - Steam OpenID callback için zorunlu
# Geliştirme ortamı:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Yayın (production) için yukarıdaki satırı kendi domain'inle değiştir: https://example.com

# Xbox / Microsoft OAuth - https://portal.azure.com adresinden ücretsiz al
# Kurulum adımları:
#   1. portal.azure.com → "App registrations" → "New registration"
#   2. Ad: GamePick | Hesap türü: "Personal Microsoft accounts only"
#   3. Redirect URI (Web): http://localhost:3000/api/auth/xbox/callback
#   4. Kaydet → "Application (client) ID" → XBOX_CLIENT_ID'ye yapıştır
#   5. "Certificates & secrets" → "New client secret" → XBOX_CLIENT_SECRET'e yapıştır
#   6. "API permissions" → "Add permission" → "Xbox Live" → XboxLive.signin + XboxLive.read ekle
XBOX_CLIENT_ID=buraya_azure_client_id_yaz
XBOX_CLIENT_SECRET=buraya_azure_client_secret_yaz
