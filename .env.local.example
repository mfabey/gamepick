# RAWG API - Ücretsiz kayıt: https://rawg.io/apidocs
RAWG_API_KEY=buraya_rawg_api_key_yaz

# IsThereAnyDeal API - Ücretsiz kayıt: https://isthereanydeal.com/dev/app/
ITAD_API_KEY=buraya_itad_api_key_yaz

# Groq API (ücretsiz) - https://console.groq.com/keys
# Llama 3.1 8B çalıştırır, AI özet + etiket + duygu analizi için kullanılır
GROQ_API_KEY=buraya_groq_api_key_yaz

# Bu dosyayı .env.local olarak kaydet (başındaki .example'ı sil)

# Apple ile giriş (WEB) — Apple Developer'da oluşturduğunuz SERVICES ID
# (uygulamanın bundle kimliği DEĞİL, ör. com.gamerisen.app.signin)
# Tanımlı değilse web'deki Apple butonu kendini gizler.
NEXT_PUBLIC_APPLE_SERVICES_ID=com.gamerisen.app.signin
