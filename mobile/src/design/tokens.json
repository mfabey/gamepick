  },
  "typography": {
    "family": {
      "sans": ["-apple-system", "SF Pro Text", "Segoe UI", "system-ui", "sans-serif"],
      "mono": ["ui-monospace", "SF Mono", "Menlo", "monospace"]
    },
    "scale": {
      "screenTitle": { "size": 34, "weight": 700, "letterSpacing": -0.75, "lineHeight": 1.1 },
      "sectionTitle": { "size": 22, "weight": 650, "letterSpacing": -0.22, "lineHeight": 1.2 },
      "cardTitle": { "size": 17, "weight": 600, "letterSpacing": 0, "lineHeight": 1.35 },
      "body": { "size": 15, "weight": 400, "letterSpacing": 0, "lineHeight": 1.45 },
      "secondary": { "size": 13, "weight": 500, "letterSpacing": 0, "lineHeight": 1.5 },
      "label": { "size": 11, "weight": 600, "letterSpacing": 0.66, "lineHeight": 1.2, "textTransform": "uppercase" }
    },
    "$kural": "Altı kademe vardır, yedincisi yoktur. 11pt yalnız büyük harfli etikette, asla cümlede."
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48],
    "screenPadding": 20,
    "cardPadding": 16,
    "listBottomSafe": 104,
    "$kural": "6, 10, 14 gibi ara değerler yasak."
  },
  "radius": { "sm": 12, "md": 16, "lg": 20, "pill": 999 },
  "size": {
    "hitSlopMin": 44,
    "tabBarHeight": 64,
    "tabBarInsetX": 20,
    "tabBarInsetBottom": 24,
    "inputHeight": 44,
    "avatarSm": 30,
    "avatarMd": 32,
    "iconTile": 32,
    "actionRailItem": 46,
    "coverRatio": "3:4",
    "videoRatio": "16:9",
    "chatBubbleMaxWidth": "78%"
  },
  "elevation": {
    "floating": { "shadowColor": "#000", "shadowOpacity": 0.55, "shadowRadius": 40, "shadowOffsetY": 16, "androidElevation": 16 },
    "card": { "shadowColor": "#000", "shadowOpacity": 0.35, "shadowRadius": 20, "shadowOffsetY": 8, "androidElevation": 8 },
    "lightFloating": { "shadowColor": "#000", "shadowOpacity": 0.12, "shadowRadius": 32, "shadowOffsetY": 12, "androidElevation": 10 }
  },
  "blur": {
    "glass": { "intensity": 32, "saturation": 1.8 },
    "$fallback": "expo-blur yoksa veya Android'de: glassFallback düz dolgu + aynı gölge. Geometri asla değişmez."
  },
  "skeleton": {
    "gradient": ["#1F2126", "#2A2C33", "#1F2126"],
    "sweepWidth": 320,
    "duration": 1400,
    "easing": "linear",
    "loop": true
  }
