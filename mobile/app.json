{
  "expo": {
    "name": "Gamerisen",
    "slug": "gamerisen",
    "version": "2.7.2",
    "orientation": "default",
    "icon": "./assets/brand/app-icon/ios-light.png",
    "scheme": "gamerisen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gamerisen.app",
      "icon": {
        "light": "./assets/brand/app-icon/ios-light.png",
        "dark": "./assets/brand/app-icon/ios-dark.png",
        "tinted": "./assets/brand/app-icon/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Gamerisen, paylaştığınız oyun kartına yalnızca şehir adını eklemek için konumunuzu kullanır. Konum bilginiz cihazınızdan çıkmaz."
      }
    },
    "android": {
      "package": "com.gamerisen.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/app-icon/android-foreground.png",
        "monochromeImage": "./assets/brand/app-icon/android-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e0a72e"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo/mark-on-light.png",
          "backgroundColor": "#F4F4F4",
          "dark": {
            "image": "./assets/brand/splash/splash-icon.png",
            "backgroundColor": "#0A0A0B"
          },
          "resizeMode": "contain",
          "imageWidth": 104
        }
      ],
      "./plugins/withIosWidget",
      "./plugins/withIosShareExtension",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Gamerisen, paylaştığınız oyun kartına yalnızca şehir adını eklemek için konumunuzu kullanır. Konum bilginiz cihazınızdan çıkmaz."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "apiBase": "https://www.gamerisen.com",
      "eas": {
        "projectId": "bb9d1812-5eeb-45ba-bd98-f07998f7fa7a",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "GamerisenWidget",
                  "bundleIdentifier": "com.gamerisen.app.GamerisenWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gamerisen.app"
                    ]
                  }
                },
                {
                  "targetName": "GamerisenShare",
                  "bundleIdentifier": "com.gamerisen.app.GamerisenShare",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gamerisen.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "googleAuth": {
        "androidEnabled": false,
        "iosEnabled": false,
        "webClientId": "554716473983-pc6au7o7nquofb6k7b25ll7mge502pp8.apps.googleusercontent.com"
      }
    },
    "owner": "mfabeys-team",
    "updates": {
      "url": "https://u.expo.dev/bb9d1812-5eeb-45ba-bd98-f07998f7fa7a"
    }
  }
}
